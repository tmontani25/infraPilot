generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
	provider = "sqlite"
}

model User {
	id        Int				@id @default(autoincrement())
	email     String		@unique
	username  String		@unique
	passwordHash  String
	role			String @default("member")
}

model CloudProvider {
  id          Int     @id
  clientId    Int
  type        String  // "openstack" | "proxmox" | "hetzner"
  name        String
  credentials Json  	// structure différente selon le type, chiffrée openstack proxmox vps
}
