generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
	provider = "sqlite"
}

model User {
	id        Int				@id @default(autoincrement())
	email     String		@unique
	username  String		@unique
	passwordHash  String
	role			String @default("member")
	clients   Client[]
}

model Client {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  users    User[]
  projects Project[]
}

model Project {
  id             Int             @id @default(autoincrement())
  clientId       Int
  client         Client          @relation(fields: [clientId], references: [id])
  name           String
  cloudProviders CloudProvider[]

  @@unique([clientId, name])
}

model CloudProvider {
  id          Int          @id @default(autoincrement())
  projectId   Int
  project     Project      @relation(fields: [projectId], references: [id])
  type        String       // "openstack" | "proxmox" | "hetzner"
  name        String
  credentials String       // JSON chiffré (AES-256-GCM), jamais stocké en clair
  deployments Deployment[]
}

model Deployment {
  id           Int      @id @default(autoincrement())
  providerId   Int
  provider     CloudProvider @relation(fields: [providerId], references: [id])
  templateId   String   // ex: "openstack-vm"
  name         String
  variables    String   // JSON des variables saisies (pas de secret ici, juste des IDs OpenStack)
  status       String   @default("pending") // pending | planned | applied | destroyed | failed
  planOutput   String?
  applyOutput  String?
  destroyOutput String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
